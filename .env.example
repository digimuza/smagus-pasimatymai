# ==========================================
# Santykiu Klausimai - Environment Variables
# ==========================================

# Database
DATABASE_URL=postgresql://payload:payload@localhost:5433/santykiuklausimai

# Payload CMS
PAYLOAD_SECRET=your-secret-at-least-32-characters-long

# App URL (used for OAuth redirects, Stripe callbacks, CORS)
NEXT_PUBLIC_URL=http://localhost:7743

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:7743/api/auth/google/callback

# OpenTelemetry (optional — @vercel/otel auto-configures on Vercel)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://...
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic ...
