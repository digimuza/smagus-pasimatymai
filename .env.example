# ==========================================
# Santykiu Klausimai - Environment Variables
# ==========================================

# Database
DATABASE_URL=postgresql://payload:payload@localhost:5433/santykiuklausimai

# App URL (used for OAuth redirects, Stripe callbacks, CORS)
# Local: http://localhost:7743 | Production: https://santykiuklausimai.lt
NEXT_PUBLIC_URL=http://localhost:7743

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# Local: http://localhost:7743/api/auth/google/callback
# Production: https://santykiuklausimai.lt/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:7743/api/auth/google/callback

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://...
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic ...

# Build metadata — injected by CI/Coolify at build time, not set manually
# COMMIT_SHA=abc1234
